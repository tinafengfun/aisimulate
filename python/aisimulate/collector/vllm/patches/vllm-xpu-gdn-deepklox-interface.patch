From 46625f79e042c78c6e9aba7ee64b3b8ecd9acd33 Mon Sep 17 00:00:00 2001
From: "Zhang, Yanli L" <yanli.l.zhang@intel.com>
Date: Mon, 12 Oct 2026 07:23:08 +0000
Subject: [PATCH] feat(gdn/xpu): expose the DeepKLOX GDN kernels

_resolve_gdn_prefill_backend returns "triton" on every non-CUDA platform,
so the XPU GDN kernels in DeepKLOX had no import path and callers that
want them -- the AIS collector benchmarks each GDN op in isolation --
failed with ModuleNotFoundError.

Forward the four primitives plus gdn_prefill_backend(), which reports
xe3p/xe2 via DeepKLOX's own is_xe3p_arch/is_xe2_arch probes, the same
ones its C++ dispatch calls, so the reported backend always names the
kernel the call reaches.

Forwarding only: DeepKLOX keeps validation and dispatch, so the two
cannot drift. DeepKLOX is optional, hence the explicit ImportError and
no package-scope import.

Verified on GPU3: 409 rows, 0 errors, labelled chunk_gated_delta_rule_xe3p.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 .../layers/mamba/gdn/deepklox_interface.py    | 60 +++++++++++++++++++
 1 file changed, 60 insertions(+)
 create mode 100644 vllm/model_executor/layers/mamba/gdn/deepklox_interface.py

diff --git a/vllm/model_executor/layers/mamba/gdn/deepklox_interface.py b/vllm/model_executor/layers/mamba/gdn/deepklox_interface.py
new file mode 100644
index 0000000000..0831135d6c
--- /dev/null
+++ b/vllm/model_executor/layers/mamba/gdn/deepklox_interface.py
@@ -0,0 +1,60 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""GDN primitives backed by DeepKLOX (XPU).
+
+The in-tree GDN layers reach their prefill scan through
+``_resolve_gdn_prefill_backend``, which returns ``"triton"`` on every
+non-CUDA platform (``qwen_gdn_linear_attn.py``). On XPU the kernels that
+actually run live in DeepKLOX, so this module exposes them under stable
+names for callers that want the XPU path explicitly -- currently the
+AIS collector, which benchmarks each GDN op in isolation:
+
+* context: ``causal_conv1d_fn`` + ``chunk_gated_delta_rule``
+* generation: ``causal_conv1d_update`` + ``gated_delta_rule_decode``
+
+This is a forwarding layer and deliberately nothing more. DeepKLOX owns
+argument validation, dtype/layout checks and the architecture dispatch,
+so re-implementing any of it here would let the two drift apart. DeepKLOX
+is an optional dependency; importing this module without it raises, which
+is why nothing imports it at package scope.
+"""
+
+from vllm.utils.import_utils import has_deepklox
+
+if not has_deepklox():
+    raise ImportError(
+        "vllm.model_executor.layers.mamba.gdn.deepklox_interface needs the "
+        "optional `deepklox` package, which provides the XPU GDN kernels."
+    )
+
+from deepklox import (  # noqa: E402
+    causal_conv1d_fn,
+    causal_conv1d_update,
+    chunk_gated_delta_rule,
+    gated_delta_rule_decode,
+)
+from deepklox.gdn_interface import _prefill_backend  # noqa: E402
+
+
+def gdn_prefill_backend(device=None) -> str | None:
+    """Name the prefill-scan specialization this device dispatches to.
+
+    Returns ``"xe3p"``, ``"xe2"``, or ``None`` when the architecture cannot
+    be resolved (no XPU, or a build without the Xe3p kernels). DeepKLOX
+    probes it through the same ``is_xe3p_arch``/``is_xe2_arch`` helpers its
+    C++ dispatch calls, so the answer always names the kernel the call will
+    reach rather than a guess from the device name.
+
+    ``device=None`` means the current XPU device, as it does for tensor
+    allocation and for the C++ dispatch itself.
+    """
+    return _prefill_backend(device)
+
+
+__all__ = [
+    "causal_conv1d_fn",
+    "causal_conv1d_update",
+    "chunk_gated_delta_rule",
+    "gated_delta_rule_decode",
+    "gdn_prefill_backend",
+]

